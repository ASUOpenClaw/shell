# Shell Proxy — local development environment
# Copy to .env and fill in required values.
# All variables use the SHELL_ prefix (single underscore, config crate separator).

# ── Server ───────────────────────────────────────────────────────────────────
SHELL_SERVER_HOST=0.0.0.0
SHELL_SERVER_PORT=8080

# ── OpenClaw Gateway ─────────────────────────────────────────────────────────
SHELL_OPENCLAW_GATEWAY_URL=http://host.docker.internal:18789
# Bearer token from OPENCLAW_GATEWAY_TOKEN on the gateway host
SHELL_OPENCLAW_GATEWAY_TOKEN="TOKEN_HERE"
# Default agent ID (matches agents.list[].id in openclaw.json)
SHELL_OPENCLAW_DEFAULT_AGENT=main
# Optional workspace→agent overrides: "ws1:agentA,ws2:agentB"
SHELL_OPENCLAW_AGENT_MAP=

# ── Redis ────────────────────────────────────────────────────────────────────
SHELL_REDIS_URL=redis://localhost:6379

# ── NATS ─────────────────────────────────────────────────────────────────────
SHELL_NATS_URL=nats://localhost:4222
SHELL_NATS_STREAM=conversations
SHELL_NATS_SUBJECT_PREFIX=conversation

# ── Rate limiting ────────────────────────────────────────────────────────────
SHELL_RATE_LIMIT_RPS=60

# ── Session ──────────────────────────────────────────────────────────────────
SHELL_SESSION_TTL_SECS=3600

# ── Timeouts ─────────────────────────────────────────────────────────────────
SHELL_REQUEST_TIMEOUT_MS=30000

# ── Observability ────────────────────────────────────────────────────────────
SHELL_LOG_LEVEL=info
# Override at runtime: RUST_LOG=shell=debug,tower_http=debug

# ── Swagger UI (disable in production) ───────────────────────────────────────
SHELL_SWAGGER_ENABLED=true
