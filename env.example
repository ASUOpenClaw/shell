# Shell Proxy — environment configuration
# Copy to .env and fill in required values.
# All variables use the SHELL_ prefix (flat, no nested separator).

# ── Server ───────────────────────────────────────────────────────────────────
SHELL_SERVER_HOST=0.0.0.0
SHELL_SERVER_PORT=8080

# ── GoClaw gateway ───────────────────────────────────────────────────────────
# URL of the GoClaw gateway (Machine 1). Per-workspace API keys are loaded
# dynamically from Redis (ws_creds:{workspace_id}) — no static token needed here.
SHELL_GOCLAW_GATEWAY_URL=http://host.docker.internal:18790

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# RSA public key PEM — must match JWT_PUBLIC_KEY in rest/.env.
# Shell only verifies tokens, never signs. Store with literal \n or real newlines.
SHELL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# ── Redis ─────────────────────────────────────────────────────────────────────
SHELL_REDIS_URL=redis://localhost:6379
SHELL_REDIS_POOL_SIZE=10

# ── NATS ─────────────────────────────────────────────────────────────────────
SHELL_NATS_URL=nats://localhost:4222
SHELL_NATS_SUBJECT_PREFIX=conversation

# ── Rate limiting ─────────────────────────────────────────────────────────────
SHELL_RATE_LIMIT_RPS=60

# ── Timeouts ──────────────────────────────────────────────────────────────────
SHELL_REQUEST_TIMEOUT_MS=30000

# ── Observability ─────────────────────────────────────────────────────────────
SHELL_LOG_LEVEL=info

# ── Swagger UI (disable in production) ───────────────────────────────────────
SHELL_SWAGGER_ENABLED=false
